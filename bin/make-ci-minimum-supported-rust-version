#!/usr/bin/env bash
# Exercise the crate on both supported older Rust minors. The fuzz package
# has its own manifest and requires nightly.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../schematron"

msrv="$(sed -nE 's/^rust-version[[:space:]]*=[[:space:]]*"(1\.[0-9]+)".*/\1/p' Cargo.toml)"
if [[ ! "${msrv}" =~ ^1\.([0-9]+)$ ]]; then
  echo "could not read a minor rust-version from schematron/Cargo.toml" >&2
  exit 2
fi
previous="1.$(( BASH_REMATCH[1] + 1 ))"
host="$(rustc -vV | sed -n 's/^host: //p')"
installed="$(rustup toolchain list)"

failed=0
for minor in "${msrv}" "${previous}"; do
  # Rustup treats 1.N and 1.N.x as different names. Use the installed
  # host toolchain's full name so an offline run works with either form.
  toolchain=""
  while read -r candidate _; do
    if [[ "${candidate}" =~ ^"${minor}"(\.[0-9]+)?-"${host}"$ ]]; then
      toolchain="${candidate}"
      break
    fi
  done <<< "${installed}"
  if [[ -z "${toolchain}" ]]; then
    echo "Rust ${minor} is missing. Install it with: rustup toolchain install ${minor} --profile minimal" >&2
    failed=1
    continue
  fi
  echo "==> ${toolchain}"
  cargo "+${toolchain}" check --locked --all-targets --all-features &&
    cargo "+${toolchain}" test --locked --all-features || failed=1
done
exit "${failed}"
